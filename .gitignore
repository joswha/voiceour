# Local launch environment sourced by scripts/run_real.sh; the app itself holds no credential
.env
.env.*
benchmarks/data/
# The bulky per-utterance `.results.jsonl` stay out; the cited report JSONs are
# committed evidence. A fully-excluded directory can never be re-included, so
# this excludes contents rather than the directory itself.
benchmarks/results/*
!benchmarks/results/*.json

# Swift build products
.build/
.swiftpm/
DerivedData/
*.app/
*.dmg
*.zip

# Model weights: acquired at runtime, never committed
models/
model-cache/

# Benchmark inputs are regenerated by `bench`; the per-utterance `.results.jsonl`
# are bulky, while the report JSONs cited by docs/ are committed evidence. A
# fully-excluded directory can never be re-included, so this excludes contents
# rather than the directory itself.
benchmarks/data/
benchmarks/results/*
!benchmarks/results/*.json
# A smoke report is a plumbing check rather than evidence: `make bench-smoke`
# writes one on every run, so it stays ignored while cited reports remain
# committable. The tier is always the component after the timestamp.
benchmarks/results/*-smoke-*.json

# Benchmark audio is synthesized or downloaded on demand
fixtures/audio/

# Python tooling under bench/
__pycache__/
*.py[cod]
.venv/
.ruff_cache/
.pytest_cache/
.cache/

# Local launch environment sourced by the Makefile's `run` and `dev` targets; the app itself holds no credential
.env
.env.*

# Editor and agent scratch
.DS_Store
.vscode/
.idea/
# A fully-excluded directory can never be re-included, so this excludes the contents
# rather than the directory itself. Two things under it are this repository's own
# maintainer tooling and are tracked: the slash commands, which encode the release
# procedure, the triage taxonomy and the cleanup gates, and the two prompt-authoring
# skills adapted for this repository. Everything else there — session scratch and the
# vendored third-party skill packs, which belong to their own upstreams — stays local.
.omp/*
!.omp/commands/
!.omp/skills/
.omp/skills/*
!.omp/skills/semantic-compression/
!.omp/skills/system-prompts/
omp-session-*.html

+    return map_cpu_buffer && buft == ggml_backend_cpu_buffer_type()
+        ? ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU)
+        : ggml_backend_buft_get_device(buft);
+}
